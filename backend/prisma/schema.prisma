generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Cliente {
  id             Int      @id @default(autoincrement())
  nombres        String
  apellidos      String?
  documento      String?  @unique
  telefono       String   @unique
  correo         String?
  observaciones  String?
  activo         Boolean  @default(true)
  fechaCreacion  DateTime @default(now())
  fechaActualiza DateTime @updatedAt

  pedidos Pedido[]

  @@index([nombres])
  @@index([apellidos])
}

model Producto {
  id Int @id @default(autoincrement())

  nombre String

  categoria CategoriaProducto

  activo Boolean @default(true)

  fechaCreacion  DateTime @default(now())
  fechaActualiza DateTime @updatedAt

  detalles DetallePedido[]

  variantes VarianteProducto[]

  @@index([nombre])
}

model VarianteProducto {
  id Int @id @default(autoincrement())

  nombre String

  medida String?

  precioBase Int

  bajoPedido Boolean @default(false)

  activo Boolean @default(true)

  productoId Int

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  orden Int @default(0)

  fechaCreacion  DateTime        @default(now())
  fechaActualiza DateTime        @updatedAt
  detallePedidos DetallePedido[]

  @@unique([productoId, nombre, medida])
}

enum CategoriaProducto {
  RETABLOS
  REGALOS_PERSONALIZADOS
  PORTARRETRATOS
  COMBOS
  COJINES
  ALBUMES
}

model Pedido {
  id             Int       @id @default(autoincrement())
  numeroPedido   String    @unique
  clienteId      Int
  fechaPedido    DateTime  @default(now())
  fechaEntrega   DateTime?
  estado         String    @default("RECIBIDO")
  formaEntrega   String?
  total          Int       @default(0)
  totalAbonado   Int       @default(0)
  saldo          Int       @default(0)
  observaciones  String?
  fechaCreacion  DateTime  @default(now())
  fechaActualiza DateTime  @updatedAt

  cliente  Cliente         @relation(fields: [clienteId], references: [id])
  detalles DetallePedido[]
  pagos    Pago[]

  @@index([clienteId])
  @@index([fechaPedido])
  @@index([fechaEntrega])
  @@index([estado])
}

model DetallePedido {
  id Int @id @default(autoincrement())

  pedidoId Int

  varianteId Int?

  nombreProducto String

  nombreVariante String?

  cantidad Int @default(1)

  precioUnitario Int

  descuento Int @default(0)

  subtotal Int

  fechaCreacion DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  variante   VarianteProducto? @relation(fields: [varianteId], references: [id])
  producto   Producto?         @relation(fields: [productoId], references: [id])
  productoId Int?

  @@index([pedidoId])
  @@index([varianteId])
}

model Pago {
  id            Int      @id @default(autoincrement())
  pedidoId      Int
  fechaPago     DateTime @default(now())
  valor         Int
  metodo        String
  referencia    String?
  observaciones String?
  fechaCreacion DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([fechaPago])
}
